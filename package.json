{
  "name": "@cubiczan/chp-rust-pack",
  "version": "0.1.0",
  "description": "Installable CHP + Rust finance pack with landing pages, rollout assets, and a scaffold CLI.",
  "type": "module",
  "license": "Proprietary",
  "bin": {
    "chp-rust-pack": "bin/chp-rust-pack.js"
  },
  "exports": {
    ".": "./index.js",
    "./pack": "./pack.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin",
    "index.js",
    "pack.js",
    "safe-path.js",
    "README.md"
  ],
  "scripts": {
    "check": "node --check bin/chp-rust-pack.js && node --check safe-path.js",
    "test": "node --test test/safe-path.test.js",
    "show": "node ./bin/chp-rust-pack.js show",
    "init": "node ./bin/chp-rust-pack.js init ./chp-rust-pack"
  },
  "engines": {
    "node": ">=24"
  }
}
